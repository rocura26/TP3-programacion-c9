// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Cada modelo representa una tabla en la base de datos.

enum Rol {
  cliente
  profesional
}

model Categoria {
  id            Int      @id @default(autoincrement())
  nombre        String   @unique @db.VarChar(100)
  descripcion   String?  @db.VarChar(255)
  profesionales User[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Zona {
  id            Int    @id @default(autoincrement())
  nombre        String @unique @db.VarChar(100)
  profesionales User[]
}

// Estados de un pedido: pendiente, aceptado, terminado...
model Estado {
  id      Int      @id @default(autoincrement())
  nombre  String   @unique @db.VarChar(50)
  pedidos Pedido[]
}

model User {
  id                     Int        @id @default(autoincrement())
  nombre                 String     @db.VarChar(100)
  email                  String     @unique @db.VarChar(255)
  password               String     @db.VarChar(72)
  rol                    Rol
  // Solo para profesionales (el DTO los exige si rol = profesional)
  categoriaId            Int?
  categoria              Categoria? @relation(fields: [categoriaId], references: [id])
  zonaId                 Int?
  zona                   Zona?      @relation(fields: [zonaId], references: [id])
  precioHora             Decimal?   @db.Decimal(10, 2)
  descripcion            String?    @db.VarChar(500)
  pedidosComoCliente     Pedido[]   @relation("PedidoCliente")
  pedidosComoProfesional Pedido[]   @relation("PedidoProfesional")
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
}

model Pedido {
  id            Int      @id @default(autoincrement())
  clienteId     Int
  cliente       User     @relation("PedidoCliente", fields: [clienteId], references: [id])
  profesionalId Int
  profesional   User     @relation("PedidoProfesional", fields: [profesionalId], references: [id])
  estadoId      Int
  estado        Estado   @relation(fields: [estadoId], references: [id])
  direccion     String   @db.VarChar(255)
  fecha         DateTime
  descripcion   String   @db.VarChar(500)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
